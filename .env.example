# StockPulz — environment variables
#
# Copy to `.env` and fill in. NAMES ONLY here; never commit real values —
# `.env` is git-ignored (.gitignore:5) and must stay that way.
#
# Generated from every `os.environ.get(...)` / `os.getenv(...)` in the codebase,
# so this is the full surface, not just what one machine happens to have set.
# Vars marked [Render] / [CI] are injected by the platform and are NOT needed in
# a local .env.


# ── Core: the bot cannot run without these ───────────────────────────────────
TELEGRAM_BOT_TOKEN=            # BotFather. Also the HMAC secret for mini-app auth.
TELEGRAM_BOT_USERNAME=         # without the @; used to build mini-app deep links
TELEGRAM_CHAT_ID=              # the admin/owner chat — receives every alert report
ANTHROPIC_API_KEY=             # pick selection + all natural-language commands
GH_GIST_TOKEN=                 # gist scope. NOTE: the name is GH_GIST_TOKEN, not
                               # GIST_TOKEN — the wrong name reads as "storage DEAD"
GIST_ID=                       # the gist that holds ALL app storage


# ── Market data ──────────────────────────────────────────────────────────────
ALPACA_KEY_ID=                 # bulk daily bars for the 600-ticker screener
ALPACA_SECRET_KEY=
FINNHUB_API_KEY=               # fundamentals — ~90% of the long-term score.
                               # Free tier is 60 req/min; the screener caps at 50.
POLYGON_API_KEY=               # options chain. ⚠️ the free tier 403s on
                               # /v3/snapshot/options, so options flow falls back
                               # to yfinance. Paying here revives the section.
FRED_API_KEY=                  # macro series (rates, inflation)
QUIVER_API_KEY=                # OPTIONAL — congressional trades. Unset = the
                               # feature is dormant (returns [] instantly), which
                               # is NOT the same as broken. Paid.


# ── Infrastructure ───────────────────────────────────────────────────────────
CRON_SECRET=                   # guards every /trigger/* endpoint. ⚠️ if it
                               # contains '#', URL-encode as %23 in cron-job.org
FLASK_SECRET_KEY=              # session signing for the admin dashboard
APP_URL=                       # public base URL, e.g. https://<svc>.onrender.com
UPSTASH_REDIS_URL=             # cache backend
UPSTASH_REDIS_TOKEN=
SENTRY_DSN=                    # OPTIONAL — error reporting
GITHUB_TOKEN=                  # dispatches daily_run.yml (the morning/weekly relay)
GITHUB_REPO=                   # OPTIONAL — defaults to vsanil/stockpulz
CRONJOB_API_KEY=               # cron-job.org REST API, for editing schedules


# ── Render diagnostics (read-only; nothing reads these yet) ──────────────────
# Without these, a failure that happens ON RENDER can only be inferred from side
# effects. It has blocked two investigations: why the Saturday run set zero
# alerts, and whether it was OOM-killed.
#   logs   GET /v1/logs?resource=$RENDER_SERVICE_ID&ownerId=$RENDER_OWNER_ID
#   events GET /v1/services/$RENDER_SERVICE_ID/events   → shows oomKilled
RENDER_API_KEY=                # dashboard → Account Settings → API Keys (rnd_…)
RENDER_SERVICE_ID=             # from the service URL: /web/srv-…
RENDER_OWNER_ID=               # tea-… or usr-… — NOT shown in the UI:
                               #   curl -H "Authorization: Bearer $RENDER_API_KEY" \
                               #        https://api.render.com/v1/owners


# ── Admin dashboard OAuth ────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ADMIN_USERNAME=         # only this GitHub login may open /admin


# ── Monetisation (optional) ──────────────────────────────────────────────────
ADSENSE_PUBLISHER_ID=
ADSENSE_SLOT_ID=


# ── 🔴 Row-store migration — LEAVE UNSET ─────────────────────────────────────
# Setting these switches ALL storage from the gist to Supabase. They must stay
# unset until a verified migration has run (scripts/migrate_to_supabase.py,
# --dry-run first). Setting them once silently pointed local runs at a DIFFERENT
# app's project holding stale data. Rollback = unset them; the gist is never
# modified.
# SUPABASE_URL=
# SUPABASE_KEY=


# ── Test / synthetic accounts ────────────────────────────────────────────────
SYNTHETIC_CHAT_ID=             # OPTIONAL — storage identity for the synthetic
                               # bot. Defaults to config_manager.DEFAULT_TEST_
                               # CHAT_ID. 🔴 must NEVER be in allowed_users, or
                               # a robot's trades steer real users' picks.


# ── Behaviour flags (all optional; sane defaults in code) ────────────────────
KEEPALIVE_ENABLED=             # 1 to re-enable the self-ping. OFF by default —
                               # StockPulz is on Render STARTER and never idles.
KEEPWARM_HOURS_ET=             # e.g. 6,7,8,9,10,11,12,13 — must cover the 7 AM ET
                               # morning relay; delivery is not idempotent.
KEEPWARM_HOURS_UTC=            # UTC form, used by the admin traffic card
MINIAPP_AUTH_DISABLED=         # 1 = trust a chat_id param instead of verifying the
                               # Telegram HMAC. DEV/TESTS ONLY — this is the
                               # account-takeover valve. Never set in production.
TELEGRAM_WEBHOOK_SECRET=       # OPTIONAL — set it, then re-register via /register
TELEGRAM_API_BASE=             # OPTIONAL — override the Telegram API host


# ── Run-time only: set by a workflow or trigger, never in .env ───────────────
# RUN_MODE          which job agent.py should run (morning, prescreener, weekly…)
# DRY_RUN           print instead of sending
# MOCK_DATA         skip screeners + Claude, use fixture picks (~10s test)
# FORCE_MORNING     bypass the once-per-day morning duplicate guard (recovery)
# OWNER_ONLY        send only to the admin
# CHAT_ID           target chat for one-off scripts


# ── [Render] / [CI] — injected by the platform, do not set locally ───────────
# RENDER              set automatically on Render; gates the live-screener guard
# RENDER_EXTERNAL_URL public URL, used by the keep-alive loop
# RENDER_GIT_COMMIT   served by /health so a deploy is verifiable
# RENDER_GIT_BRANCH
# PORT                bind port
# GITHUB_REPOSITORY   set by GitHub Actions
