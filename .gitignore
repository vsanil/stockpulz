# Python
__pycache__/
*.py[cod]
*.pyo
.env
venv/
.venv/

# Graphify cache (auto-generated build artifacts)
graphify-out/cache/

# walk-forward backtest artifacts (bar cache + holdout-view ledger)
scripts/.backtest_bars.pkl
scripts/.holdout_views.json
analysis/findings_state.json
