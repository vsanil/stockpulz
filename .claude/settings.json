{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/claude_hook.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/scripts/claude_hook.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(curl -s https://stock-agent-enqx.onrender.com/health)",
      "Bash(curl -s -H *)",
      "Bash(python3 scripts/check_js.py)",
      "Bash(python3 -m py_compile *)",
      "Bash(python3 -m pytest tests/ *)",
      "Bash(python3 -m pytest tests/test_*)"
    ]
  }
}
